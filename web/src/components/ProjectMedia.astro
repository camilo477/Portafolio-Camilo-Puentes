---
import type { CollectionEntry } from 'astro:content';
import ProjectImage from './ProjectImage.astro';
interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { media, lang } = entry.data;
---

{media.gallery.length > 0 && (
  <div class="project-gallery">
    {media.gallery.map((image) => (
      <ProjectImage image={image} />
    ))}
  </div>
)}
{media.videos.map((video) => (
  <figure class="project-video">
    <video
      controls
      preload="none"
      playsinline
      poster={video.poster}
      width={video.width}
      height={video.height}
      aria-label={video.title}
    >
      <source
        src={video.src}
        type={video.src.endsWith('.webm') ? 'video/webm' : 'video/mp4'}
      />
      {video.captions.map((track) => (
        <track
          kind="captions"
          src={track.src}
          srclang={track.lang}
          label={track.label}
          default={track.lang === lang}
        />
      ))}
    </video>
  </figure>
))}
