---
interface Props {
  name: 'github' | 'linkedin' | 'email' | 'cv' | 'copy';
}
const { name } = Astro.props;
---

{name === 'github' ? (
  <svg
    width="22"
    height="22"
    viewBox="0 0 16 16"
    fill="currentColor"
    aria-hidden="true"
    focusable="false"
  >
    <!-- GitHub mark from Primer Octicons, MIT; license in public/licenses/octicons.txt. -->
    <path d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656" />
  </svg>
) : (
  <svg
    width="22"
    height="22"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {name === 'email' && (
      <>
        <rect x="3" y="5" width="18" height="14" rx="2" />
        <path d="m3 6 9 7 9-7" />
      </>
    )}
    {name === 'copy' && (
      <>
        <rect x="8" y="8" width="12" height="13" rx="2" />
        <path d="M16 8V3H3v13h5" />
      </>
    )}
    {name === 'cv' && (
      <>
        <path d="M14 3H5v18h14V8Z M14 3v5h5 M8 12h8 M8 16h6" />
      </>
    )}
    {name === 'linkedin' && (
      <>
        <rect x="3" y="3" width="18" height="18" rx="2" />
        <path d="M7 10v7 M11 17v-7 M11 13c0-4 6-4 6 0v4" />
        <circle cx="7" cy="7" r="0.7" fill="currentColor" />
      </>
    )}
  </svg>
)}
