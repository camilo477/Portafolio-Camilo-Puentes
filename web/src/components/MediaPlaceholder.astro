---
import { copy } from '../lib/i18n';
import type { Language } from '../lib/routes';
interface Props {
  lang: Language;
  name: string;
  compact?: boolean;
}
const { lang, name, compact = false } = Astro.props;
const t = copy[lang];
---

<div class:list={['media-placeholder', { compact }]}>
  <span class="media-path" aria-hidden="true">
    {name} /
  </span>
  <div class="media-message">
    <span class="media-frame" aria-hidden="true"></span>
    <strong>{t.screenshot}</strong>
    {!compact && <span>{t.screenshotNote}</span>}
  </div>
</div>
