---
import { copy } from '../lib/i18n';
import type { Language } from '../lib/routes';
interface Props {
  lang: Language;
  name: string;
  kind?: 'screenshot' | 'video';
}
const { lang, name, kind = 'screenshot' } = Astro.props;
const t = copy[lang];
---

<div class="media-placeholder">
  <span class="media-path" aria-hidden="true">
    {name} /
  </span>
  <div class="media-message">
    <span class="media-frame" aria-hidden="true"></span>
    <strong>{kind === 'video' ? t.video : t.screenshot}</strong>
    <span>{kind === 'video' ? t.videoNote : t.screenshotNote}</span>
  </div>
</div>
