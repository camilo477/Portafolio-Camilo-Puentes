---
import { copy } from '../lib/i18n';
import type { Language } from '../lib/routes';
interface Props {
  lang: Language;
  name: string;
  kind?: 'screenshot' | 'video';
}
const { lang, name, kind = 'screenshot' } = Astro.props;
const t = copy[lang];
---

<p class="media-placeholder pending-note" data-media-for={name}>
  {kind === 'video' ? t.mediaVideoPending : t.mediaPending}
</p>
