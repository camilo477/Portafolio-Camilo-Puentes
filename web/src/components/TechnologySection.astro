---
import {
  technologyCategories,
  mainStackAreas,
  explorationIds,
} from '../data/technologies';
import { copy } from '../lib/i18n';
import { commands, technologiesAnchor, type Language } from '../lib/routes';
import TechnologyList from './TechnologyList.astro';
import CommandLabel from './CommandLabel.astro';
import '../styles/technologies.css';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = copy[lang];
---

<section
  class="technologies"
  id={technologiesAnchor(lang)}
  aria-labelledby="technologies-heading"
>
  <div class="section-heading">
    <div>
      <CommandLabel command={commands.technologies} />
      <h2 id="technologies-heading">{t.technologyHeading}</h2>
    </div>
    <p class="section-intro">{t.mainStackIntro}</p>
  </div>
  <div class="stack-workspace">
    <div class="stack-file">
      <span aria-hidden="true">~/skills/</span>
      <span>stack.yaml</span>
      <span class="stack-file-caption">{t.mainStack}</span>
    </div>
    <div class="main-stack" aria-label={t.mainStack}>
      {mainStackAreas.map(({ id, items }) => (
        <section
          class:list={['stack-area', `area-${id}`]}
          aria-labelledby={`area-${id}-title`}
        >
          <h3 id={`area-${id}-title`}>
            <span class="stack-key" aria-hidden="true">
              {id}:
            </span>
            {t.stackAreas[id]}
          </h3>
          <TechnologyList items={items} lang={lang} labelLearning />
        </section>
      ))}
    </div>
  </div>
  <aside class="stack-exploration" aria-labelledby="exploration-heading">
    <div>
      <h3 id="exploration-heading">{t.exploration}</h3>
      <p>{t.explorationIntro}</p>
    </div>
    <TechnologyList items={explorationIds} lang={lang} />
  </aside>
  <details class="stack-inventory">
    <summary
      aria-labelledby="inventory-heading"
      data-preview-command={commands.technologies}
    >
      <span id="inventory-heading">
        <span class="inventory-closed">{t.allTechnologies}</span>
        <span class="inventory-open">{t.closeTechnologies}</span>
      </span>
      <span class="inventory-mark" aria-hidden="true">
        +
      </span>
    </summary>
    <p class="inventory-note">
      {t.inventoryNote} {t.technologyDocumentation}
    </p>
    <div class="inventory-grid">
      {technologyCategories.map(({ id, items }) => (
        <section
          class="stack-category"
          data-technology-group={id}
          aria-labelledby={`stack-${id}-title`}
        >
          <h3 id={`stack-${id}-title`}>{t.technologyCategories[id]}</h3>
          <TechnologyList items={items} lang={lang} />
        </section>
      ))}
    </div>
  </details>
</section>
