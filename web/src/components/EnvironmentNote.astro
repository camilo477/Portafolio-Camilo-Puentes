---
import { copy } from '../lib/i18n';
import type { Language } from '../lib/routes';
import CommandLabel from './CommandLabel.astro';
interface Props {
  lang: Language;
}
const t = copy[Astro.props.lang];
---

<aside class="environment" aria-labelledby="environment-heading">
  <div class="environment-caption">
    <span class="environment-index" aria-hidden="true">
      ~/
    </span>
    <h2 id="environment-heading">{t.environment}</h2>
  </div>
  <div class="environment-composition">
    <svg
      class="plasma-folds"
      viewBox="0 0 400 250"
      fill="none"
      aria-hidden="true"
    >
      <path class="fold-outline" d="M44 187 159 28h177L222 187H44Z" />
      <path class="fold-teal" d="m93 192 91-127h127l-91 127H93Z" />
      <path class="fold-amber" d="m222 192 58-82 57 82H222Z" />
      <path class="fold-green" d="m93 192 51-72 28 72H93Z" />
      <path class="fold-line" d="M44 207h293M67 219h249" />
    </svg>
    <p class="environment-system">
      Linux<span>KDE Plasma</span>
    </p>
    <span class="environment-path" aria-hidden="true">
      ~ / desktop
    </span>
  </div>
  <div class="environment-note">
    <CommandLabel command="cd ~/homelab" />
    <p>{t.environmentText}</p>
  </div>
</aside>
