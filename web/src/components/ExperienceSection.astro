---
import { publishedExperience } from '../lib/experience';
import CommandLabel from './CommandLabel.astro';
import { copy } from '../lib/i18n';
import { commands, experienceAnchor, type Language } from '../lib/routes';
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const t = copy[lang];
const entries = await publishedExperience(lang);
---

{entries.length > 0 && (
  <section
    class="experience"
    id={experienceAnchor(lang)}
    aria-labelledby="experience-heading"
  >
    <div class="section-heading">
      <div>
        <CommandLabel command={commands.experience} />
        <h2 id="experience-heading">{t.experience}</h2>
      </div>
    </div>
    {entries.map((entry, index) => (
      <article
        class="experience-entry"
        aria-labelledby={`experience-role-${index}`}
      >
        <header class="experience-meta">
          <p class="experience-company">{entry.company}</p>
          <p class="experience-period">{entry.period}</p>
          {entry.progression && (
            <p class="experience-progression">{entry.progression}</p>
          )}
        </header>
        <div class="experience-body">
          <h3 id={`experience-role-${index}`}>{entry.role}</h3>
          {entry.responsibilities.map((item) => (
            <p class="experience-description">{item}</p>
          ))}
          {entry.contributions.length > 0 && (
            <>
              <h4>{t.contributions}</h4>
              <ul class="experience-contributions">
                {entry.contributions.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </>
          )}
          <div class="experience-technologies">
            <h4>{t.projectStack}</h4>
            <p>{entry.technologies.join(' · ')}</p>
          </div>
        </div>
      </article>
    ))}
  </section>
)}
