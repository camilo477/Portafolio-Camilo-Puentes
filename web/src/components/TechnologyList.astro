---
import { technologies, type TechnologyId } from '../data/technologies';
import { commands, type Language } from '../lib/routes';

interface Props {
  items: readonly TechnologyId[];
  lang: Language;
}
const { items, lang } = Astro.props;
---

<ul class="technology-list" role="list">
  {items.map((id) => {
    const technology = technologies[id];
    const name =
      typeof technology.name === 'string'
        ? technology.name
        : technology.name[lang];
    return (
      <li>
        <span
          class="technology-name"
          data-technology={id}
          data-preview-command={technology.command ?? commands.technologies}
        >
          {name}
        </span>
      </li>
    );
  })}
</ul>
