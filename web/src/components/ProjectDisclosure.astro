---
import { render, type CollectionEntry } from 'astro:content';
import MediaPlaceholder from './MediaPlaceholder.astro';
import CommandLabel from './CommandLabel.astro';
import { copy } from '../lib/i18n';
import { commands } from '../lib/routes';
import '../styles/projects.css';
interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { lang, projectId, title, category, description, repository, media } =
  entry.data;
const t = copy[lang];
const { Content } = await render(entry);
---

<article
  class:list={['project-story', `story-${projectId}`]}
  aria-labelledby={`${projectId}-title`}
>
  <details
    class="project-row"
    id={projectId}
    name="portfolio-projects"
    data-project={projectId}
  >
    <summary
      data-preview-command={commands[projectId]}
      aria-labelledby={`${projectId}-title`}
      aria-describedby={`${projectId}-description`}
      aria-controls={`${projectId}-content`}
    >
      <h3 class="project-summary" aria-labelledby={`${projectId}-title`}>
        <span class="project-category">{category}</span>
        <span class="project-title" id={`${projectId}-title`}>
          {title}
        </span>
        <span class="project-description" id={`${projectId}-description`}>
          {description}
        </span>
        <span class="project-toggle" aria-hidden="true">
          <span class="when-closed">{t.expandProject}</span>
          <span class="when-open">{t.collapseProject}</span>
          <span class="project-arrow">↗</span>
        </span>
      </h3>
    </summary>
    <div class="project-reveal">
      <div class="project-expanded" id={`${projectId}-content`}>
        <CommandLabel command={commands[projectId]} />
        <div class="prose">
          <Content />
        </div>
        <a class="repository-link" href={repository}>
          {t.repository}
          <span class="sr-only">: {title}</span>
        </a>
        <p class="project-status">{t.draft}</p>
      </div>
    </div>
  </details>
  <div class="project-visual">
    <div class="project-media-caption">
      <span>{projectId === 'convertix' ? t.videoFormat : t.projectMedia}</span>
      <span class="project-file" aria-hidden="true">
        {projectId}/
      </span>
    </div>
    <MediaPlaceholder lang={lang} name={projectId} kind={media} />
    {projectId === 'nube-camiska' && (
      <p class="project-platform">
        <span>Linux</span>
        <span aria-hidden="true">/</span>
        <span>Docker</span>
      </p>
    )}
  </div>
</article>
