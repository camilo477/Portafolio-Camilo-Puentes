---
import type { ProjectImage } from '../lib/content-models';
interface Props {
  image: ProjectImage;
  eager?: boolean;
}
const { image, eager = false } = Astro.props;
---

<figure class="project-image">
  <img
    src={image.src}
    alt={image.alt}
    width={image.width}
    height={image.height}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
  />
  {image.caption && <figcaption>{image.caption}</figcaption>}
</figure>
