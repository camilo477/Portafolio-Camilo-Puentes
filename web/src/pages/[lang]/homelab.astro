---
import { homelabPath, languages, type Language } from '../../lib/routes';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
// Preserve old shared links; Homelab now expands in the home page.
return Astro.redirect(homelabPath(Astro.params.lang as Language), 301);
---
