---
import { getCollection, type CollectionEntry } from 'astro:content';
import { projectAnchor, projectPath } from '../../../lib/routes';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: {
      lang: entry.data.lang,
      section: projectAnchor(entry.data.lang),
      project: entry.data.projectId,
    },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
// Keep previously shared URLs working; project content now lives on the homepage.
return Astro.redirect(projectPath(entry.data.lang, entry.data.projectId));
---
