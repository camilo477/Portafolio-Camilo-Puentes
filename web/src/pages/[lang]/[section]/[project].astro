---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CommandLabel from '../../../components/CommandLabel.astro';
import ProjectActions from '../../../components/ProjectActions.astro';
import ProjectImage from '../../../components/ProjectImage.astro';
import ProjectMedia from '../../../components/ProjectMedia.astro';
import { copy } from '../../../lib/i18n';
import type { IndexEntry } from '../../../lib/context-index';
import { commands, projectAnchor, homePath } from '../../../lib/routes';
import '../../../styles/case-study.css';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: {
      lang: entry.data.lang,
      section: projectAnchor(entry.data.lang),
      project: entry.data.projectId,
    },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const {
  lang,
  projectId,
  title,
  category,
  description,
  problem,
  features,
  technologies,
  contribution,
  decisions,
  architecture,
  media,
  sources,
} = entry.data;
const t = copy[lang];
const sections = [
  { id: 'overview', label: t.overview, visible: true },
  {
    id: 'media-heading',
    label: t.mediaHeading,
    visible: media.gallery.length > 0 || media.videos.length > 0,
  },
  { id: 'problem-heading', label: t.problem, visible: Boolean(problem) },
  { id: 'features-heading', label: t.features, visible: features.length > 0 },
  { id: 'stack-heading', label: t.projectStack, visible: true },
  {
    id: 'contribution-heading',
    label: t.contribution,
    visible: Boolean(contribution),
  },
  {
    id: 'decisions-heading',
    label: t.decisions,
    visible: decisions.length > 0,
  },
  {
    id: 'architecture-heading',
    label: t.architecture,
    visible: Boolean(architecture.summary || architecture.diagram),
  },
  { id: 'sources-heading', label: t.sources, visible: sources.length > 0 },
];
const indexEntries: IndexEntry[] = sections
  .filter((section) => section.visible)
  .map(({ id, label }) => ({ id, label, command: commands[projectId] }));
---

<BaseLayout
  lang={lang}
  title={`${title} · ${t.siteTitle}`}
  description={description}
  route={projectId}
  indexEntries={indexEntries}
  project={{ repository: entry.data.repository }}
>
  <article class:list={['case-study', `case-${projectId}`]}>
    <a
      class="back-link"
      href={homePath(lang)}
      data-back-link
      data-preview-command={commands.home}
    >
      <span aria-hidden="true">← </span>
      {t.back}
    </a>
    <header class="case-intro" id="overview">
      <div class="case-title">
        <CommandLabel command={commands[projectId]} />
        <h1>{title}</h1>
        <p class="case-description">{description}</p>
      </div>
      <div class="case-access">
        <p class="case-category">{category}</p>
        <ProjectActions entry={entry} />
      </div>
    </header>
    {media.cover && (
      <div class="case-cover">
        <ProjectImage image={media.cover} eager />
      </div>
    )}
    {(media.gallery.length > 0 || media.videos.length > 0) && (
      <section class="case-section case-media" aria-labelledby="media-heading">
        <h2 id="media-heading">{t.mediaHeading}</h2>
        <div>
          <ProjectMedia entry={entry} />
        </div>
      </section>
    )}
    {problem && (
      <section class="case-section" aria-labelledby="problem-heading">
        <h2 id="problem-heading">{t.problem}</h2>
        <p>{problem}</p>
      </section>
    )}
    {features.length > 0 && (
      <section class="case-section" aria-labelledby="features-heading">
        <h2 id="features-heading">{t.features}</h2>
        <ul class="case-list">
          {features.map((feature) => (
            <li>{feature}</li>
          ))}
        </ul>
      </section>
    )}
    <section class="case-section" aria-labelledby="stack-heading">
      <h2 id="stack-heading">{t.projectStack}</h2>
      <ul class="case-stack">
        {technologies.map((technology) => (
          <li>{technology}</li>
        ))}
      </ul>
    </section>
    {contribution && (
      <section class="case-section" aria-labelledby="contribution-heading">
        <h2 id="contribution-heading">{t.contribution}</h2>
        <p>{contribution}</p>
      </section>
    )}
    {decisions.length > 0 && (
      <section class="case-section" aria-labelledby="decisions-heading">
        <h2 id="decisions-heading">{t.decisions}</h2>
        <ul class="case-list">
          {decisions.map((decision) => (
            <li>{decision}</li>
          ))}
        </ul>
      </section>
    )}
    {(architecture.summary || architecture.diagram) && (
      <section class="case-section" aria-labelledby="architecture-heading">
        <h2 id="architecture-heading">{t.architecture}</h2>
        <div class="case-architecture">
          {architecture.summary && <p>{architecture.summary}</p>}
          {architecture.diagram && (
            <ProjectImage image={architecture.diagram} />
          )}
        </div>
      </section>
    )}
    {sources.length > 0 && (
      <section
        class="case-section case-sources"
        aria-labelledby="sources-heading"
      >
        <h2 id="sources-heading">{t.sources}</h2>
        <div>
          <p>{t.sourcesNote}</p>
          <ul>
            {sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer">
                  {source.label}
                  <span class="sr-only">, {t.newTab}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
    <a
      class="back-link case-back"
      href={homePath(lang)}
      data-back-link
      data-preview-command={commands.home}
    >
      <span aria-hidden="true">← </span>
      {t.back}
    </a>
  </article>
</BaseLayout>

<script>
  import { initializeBackLinks } from '../../../scripts/back-links';
  initializeBackLinks();
</script>
