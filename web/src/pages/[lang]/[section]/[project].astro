---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MediaPlaceholder from '../../../components/MediaPlaceholder.astro';
import { copy } from '../../../lib/i18n';
import { commands, projectAnchor, projectsPath } from '../../../lib/routes';
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({
    params: {
      lang: entry.data.lang,
      section: projectAnchor(entry.data.lang),
      project: entry.data.projectId,
    },
    props: { entry },
  }));
}
interface Props {
  entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { lang, projectId, title, description, repository } = entry.data;
const t = copy[lang];
const { Content } = await render(entry);
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  route={projectId}
>
  <article class="project-detail">
    <a
      class="back-link"
      href={projectsPath(lang)}
      data-preview-command={commands.projects}
    >
      ← {t.back}
    </a>
    <p class="command-heading" aria-hidden="true">
      $ {commands[projectId]}
    </p>
    <h1>{title}</h1>
    <p class="detail-description">{description}</p>
    <p class="project-status">{t.draft}</p>
    <MediaPlaceholder lang={lang} name={projectId} />
    <div class="prose">
      <Content />
    </div>
    <a class="repository-link" href={repository}>
      {t.repository}
    </a>
    <aside class="evidence-note">
      <h2>{t.evidence}</h2>
      <p>{t.evidenceNote}</p>
    </aside>
  </article>
</BaseLayout>
