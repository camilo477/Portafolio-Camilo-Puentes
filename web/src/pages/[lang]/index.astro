---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectStory from '../../components/ProjectStory.astro';
import TechnologySection from '../../components/TechnologySection.astro';
import ExperienceSection from '../../components/ExperienceSection.astro';
import HomelabDisclosure from '../../components/HomelabDisclosure.astro';
import CommandLabel from '../../components/CommandLabel.astro';
import '../../styles/home.css';
import { copy } from '../../lib/i18n';
import { professional } from '../../data/professional';
import {
  commands,
  languages,
  homeAnchor,
  projectAnchor,
  projectIds,
  projectsPath,
  type Language,
} from '../../lib/routes';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = copy[lang];
const projects = await getCollection(
  'projects',
  ({ data }) => data.lang === lang,
);
const orderedProjects = projectIds.map((id) =>
  projects.find(({ data }) => data.projectId === id)!,
);
---

<BaseLayout lang={lang} title={t.siteTitle}>
  <section class="introduction" aria-labelledby="intro-heading">
    <div class="intro-copy" id={homeAnchor(lang)}>
      <div class="intro-overline">
        <CommandLabel command="whoami" />
        <span>{t.professionalPortfolio}</span>
      </div>
      <h1 id="intro-heading">
        <span>Camilo Alberto</span> <span>Puentes Valencia</span>
      </h1>
      <p class="role">{t.role}</p>
      <p class="intro-text">{t.intro}</p>
      <div class="intro-links">
        <a
          class="primary-link"
          href={projectsPath(lang)}
          data-preview-command={commands.projects}
        >
          {t.explore}
          <span aria-hidden="true">↓</span>
        </a>
        <a href={professional.github} target="_blank" rel="noopener noreferrer">
          {t.github}
          <span class="sr-only">, {t.newTab}</span>
        </a>
      </div>
    </div>
  </section>
  <TechnologySection lang={lang} />
  <section
    class="projects"
    id={projectAnchor(lang)}
    aria-labelledby="projects-heading"
  >
    <div class="section-heading">
      <div>
        <CommandLabel command={commands.projects} />
        <h2 id="projects-heading">{t.projects}</h2>
      </div>
    </div>
    <div class="project-list">
      {orderedProjects.map((entry) => (
        <ProjectStory entry={entry} />
      ))}
    </div>
  </section>
  <ExperienceSection lang={lang} />
  <HomelabDisclosure lang={lang} />
</BaseLayout>
