---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectDisclosure from '../../components/ProjectDisclosure.astro';
import TechnologySection from '../../components/TechnologySection.astro';
import { copy } from '../../lib/i18n';
import {
  commands,
  languages,
  projectAnchor,
  projectIds,
  projectsPath,
  type Language,
} from '../../lib/routes';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = copy[lang];
const projects = await getCollection(
  'projects',
  ({ data }) => data.lang === lang,
);
const orderedProjects = projectIds.map((id) =>
  projects.find(({ data }) => data.projectId === id)!,
);
---

<BaseLayout lang={lang} title={t.siteTitle}>
  <section class="introduction" aria-labelledby="intro-heading">
    <div class="intro-copy">
      <p class="command-heading" aria-hidden="true">
        $ whoami
      </p>
      <h1 id="intro-heading">
        <span>Camilo Alberto</span> <span>Puentes Valencia</span>
      </h1>
      <p class="role">{t.role}</p>
      <p class="intro-text">{t.intro}</p>
      <div class="intro-links">
        <a
          class="primary-link"
          href={projectsPath(lang)}
          data-preview-command={commands.projects}
        >
          {t.explore}
          <span aria-hidden="true">↓</span>
        </a>
        <a href="https://github.com/camilo477">{t.github}</a>
      </div>
    </div>
    <aside class="desktop-note" aria-labelledby="environment-heading">
      <p class="command-heading" aria-hidden="true">
        $ cd ~/homelab
      </p>
      <h2 id="environment-heading">{t.environment}</h2>
      <p class="desktop-name">Linux / KDE Plasma</p>
      <p>{t.environmentText}</p>
    </aside>
  </section>
  <section
    class="projects"
    id={projectAnchor(lang)}
    aria-labelledby="projects-heading"
  >
    <div class="section-heading">
      <h2 id="projects-heading">{t.projects}</h2>
      <span class="command-heading" aria-hidden="true">
        $ {commands.projects}
      </span>
    </div>
    <p class="section-intro">{t.projectIntro}</p>
    <div class="project-list">
      {orderedProjects.map((entry) => (
        <ProjectDisclosure entry={entry} />
      ))}
    </div>
  </section>
  <TechnologySection lang={lang} />
</BaseLayout>
