---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MediaPlaceholder from '../../components/MediaPlaceholder.astro';
import { copy } from '../../lib/i18n';
import {
  commands,
  languages,
  projectAnchor,
  projectPath,
  projectsPath,
  type Language,
} from '../../lib/routes';
export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Language;
const t = copy[lang];
const projects = await getCollection(
  'projects',
  ({ data }) => data.lang === lang,
);
const featured = projects.find(({ data }) => data.projectId === 'dianimilo')!;
const secondary = projects.find(
  ({ data }) => data.projectId === 'nube-camiska',
)!;
---

<BaseLayout lang={lang} title={t.role}>
  <section class="introduction" aria-labelledby="intro-heading">
    <div class="intro-copy">
      <p class="command-heading" aria-hidden="true">
        $ whoami
      </p>
      <h1 id="intro-heading">
        Camilo Puentes<span class="name-period">.</span>
      </h1>
      <p class="role">{t.role}</p>
      <p class="intro-text">{t.intro}</p>
      <div class="intro-links">
        <a
          class="primary-link"
          href={projectsPath(lang)}
          data-preview-command={commands.projects}
        >
          {t.explore}
          <span aria-hidden="true">↓</span>
        </a>
        <a href="https://github.com/camilo477">{t.github}</a>
      </div>
    </div>
    <aside class="desktop-note" aria-labelledby="environment-heading">
      <p class="command-heading" aria-hidden="true">
        $ cd ~/homelab
      </p>
      <h2 id="environment-heading">{t.environment}</h2>
      <p class="desktop-name">Linux / KDE Plasma</p>
      <p>{t.environmentText}</p>
    </aside>
  </section>
  <section
    class="projects"
    id={projectAnchor(lang)}
    aria-labelledby="projects-heading"
  >
    <div class="section-heading">
      <h2 id="projects-heading">{t.projects}</h2>
      <span class="command-heading" aria-hidden="true">
        $ {commands.projects}
      </span>
    </div>
    <p class="section-intro">{t.projectIntro}</p>
    <article class="featured-project">
      <div class="project-copy">
        <p class="project-category">{featured.data.category}</p>
        <h3>
          <a
            href={projectPath(lang, featured.data.projectId)}
            data-preview-command={commands.dianimilo}
          >
            {featured.data.title}
          </a>
        </h3>
        <p class="project-description">{featured.data.description}</p>
        <p class="project-status">{t.draft}</p>
        <a
          class="project-action"
          href={projectPath(lang, featured.data.projectId)}
          data-preview-command={commands.dianimilo}
        >
          {t.projectLink}
          <span class="sr-only">: {featured.data.title}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
      <MediaPlaceholder lang={lang} name="dianimilo" />
    </article>
    <article class="secondary-project">
      <MediaPlaceholder lang={lang} name="nube-camiska" compact />
      <div class="project-copy">
        <p class="project-category">{secondary.data.category}</p>
        <h3>
          <a
            href={projectPath(lang, secondary.data.projectId)}
            data-preview-command={commands['nube-camiska']}
          >
            {secondary.data.title}
          </a>
        </h3>
        <p class="project-description">{secondary.data.description}</p>
      </div>
      <a
        class="project-action"
        href={projectPath(lang, secondary.data.projectId)}
        data-preview-command={commands['nube-camiska']}
      >
        {t.projectLink}
        <span class="sr-only">: {secondary.data.title}</span>
        <span aria-hidden="true">↗</span>
      </a>
    </article>
  </section>
</BaseLayout>
