---
import '../styles/global.css';
import '../styles/sidebars.css';
import ProfessionalLinks from '../components/ProfessionalLinks.astro';
import ContextIndex from '../components/ContextIndex.astro';
import Seo from '../components/Seo.astro';
import { homeIndex, type IndexEntry } from '../lib/context-index';
import { publishedExperience } from '../lib/experience';
import { copy } from '../lib/i18n';
import {
  commands,
  experiencePath,
  homelabPath,
  projectIds,
  type ProjectId,
  homePath,
  localizedPath,
  projectsPath,
  technologiesPath,
  type Language,
  type RouteId,
} from '../lib/routes';

interface Props {
  lang: Language;
  title: string;
  description?: string;
  route?: RouteId;
  indexEntries?: IndexEntry[];
  project?: { repository: string };
}
const {
  lang,
  title,
  description = copy[lang].intro,
  route = 'home',
} = Astro.props;
const t = copy[lang];
const hasExperience = (await publishedExperience(lang)).length > 0;
const indexEntries =
  Astro.props.indexEntries ??
  (route === 'home' ? homeIndex(lang, hasExperience) : []);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <Seo
      lang={lang}
      route={route}
      title={title}
      description={description}
      project={Astro.props.project}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('portfolio-theme');
        if (theme === 'light' || theme === 'dark')
          document.documentElement.dataset.theme = theme;
      } catch {
        /* System colors remain available when storage is blocked. */
      }
    </script>
  </head>
  <body data-route={route}>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <div class="reading-tools-region">
      <header class="site-header">
        <div class="header-inner wrap">
          <div class="preferences">
            <nav class="languages" aria-label={t.language}>
              {(['es', 'en'] as const).map((language) => (
                <a
                  href={localizedPath(language, route)}
                  lang={language}
                  hreflang={language}
                  data-language={language}
                  aria-current={language === lang ? 'true' : undefined}
                  aria-label={
                    language === 'es' ? 'ES — Español' : 'EN — English'
                  }
                >
                  {language.toUpperCase()}
                </a>
              ))}
            </nav>
            <button
              class="theme-toggle"
              type="button"
              data-theme-toggle
              disabled
              aria-label={t.switchDark}
            >
              <svg
                class="theme-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="8" />
                <path
                  d="M12 4a8 8 0 0 0 0 16Z"
                  fill="currentColor"
                  stroke="none"
                />
              </svg>
              <span data-theme-label>{t.dark}</span>
            </button>
          </div>
          <ContextIndex lang={lang} entries={indexEntries} />
        </div>
      </header>
    </div>
    <div class="side-margin side-margin-left">
      <ProfessionalLinks lang={lang} variant="rail" />
    </div>
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div>
        <p>{t.footer}</p>
        <nav class="main-nav footer-nav" aria-label={t.navigation}>
          <a
            href={homePath(lang)}
            data-preview-command={commands.home}
            aria-current={route === 'home' ? 'page' : undefined}
          >
            {t.home}
          </a>
          <a
            href={technologiesPath(lang)}
            data-preview-command={commands.technologies}
          >
            {t.technologies}
          </a>
          {hasExperience && (
            <a
              href={experiencePath(lang)}
              data-preview-command={commands.experience}
            >
              {t.experienceShort}
            </a>
          )}
          <a
            href={projectsPath(lang)}
            data-preview-command={commands.projects}
            aria-current={
              projectIds.includes(route as ProjectId) ? 'true' : undefined
            }
          >
            {t.projects}
          </a>
          <a
            href={homelabPath(lang)}
            data-preview-command={commands.homelab}
            aria-current={route === 'homelab' ? 'page' : undefined}
          >
            {t.homelab}
          </a>
        </nav>
      </div>
      <ProfessionalLinks lang={lang} variant="footer" />
      <label class="motion-control">
        <input type="checkbox" data-motion-toggle checked disabled />
        {t.motion}
      </label>
      <noscript>
        <p>{t.noJS}</p>
      </noscript>
    </footer>
    <div
      class="command-bar"
      aria-hidden="true"
      data-command-bar
      data-state="idle"
    >
      <div class="wrap command-inner">
        <span class="command-prompt">
          <span>camilo@portfolio:~</span>$
        </span>
        <span class="command-text" data-command>
          {commands[route]}
        </span>
        <span class="command-state" data-command-label>
          {t.route}
        </span>
      </div>
    </div>
    <script>
      import { initializePreferences } from '../scripts/preferences';
      import { initializeCommands } from '../scripts/commands';
      import { initializeHeader } from '../scripts/header';
      import { initializeHomelab } from '../scripts/homelab';
      import { initializeSidebars } from '../scripts/sidebars';
      initializeHeader();
      initializePreferences();
      initializeHomelab();
      initializeCommands();
      initializeSidebars();
    </script>
  </body>
</html>
