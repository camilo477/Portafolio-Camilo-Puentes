---
import '../styles/global.css';
import { copy } from '../lib/i18n';
import {
  commands,
  homePath,
  localizedPath,
  projectsPath,
  type Language,
  type RouteId,
} from '../lib/routes';

interface Props {
  lang: Language;
  title: string;
  description?: string;
  route?: RouteId;
}
const {
  lang,
  title,
  description = copy[lang].intro,
  route = 'home',
} = Astro.props;
const t = copy[lang];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="es" href={localizedPath('es', route)} />
    <link rel="alternate" hreflang="en" href={localizedPath('en', route)} />
    <title>{title} · Camilo Puentes</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('portfolio-theme');
        if (theme === 'light' || theme === 'dark')
          document.documentElement.dataset.theme = theme;
      } catch {
        /* System colors remain available when storage is blocked. */
      }
    </script>
  </head>
  <body data-route={route}>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    <header class="site-header wrap">
      <a
        class="identity"
        href={homePath(lang)}
        data-preview-command={commands.home}
        aria-label="Camilo Puentes"
      >
        <span class="identity-name">
          camilo
          <span class="identity-slash" aria-hidden="true">
            /
          </span>
          puentes
        </span>
      </a>
      <nav class="main-nav" aria-label={t.navigation}>
        <a
          href={homePath(lang)}
          data-preview-command={commands.home}
          aria-current={route === 'home' ? 'page' : undefined}
        >
          {t.home}
        </a>
        <a href={projectsPath(lang)} data-preview-command={commands.projects}>
          {t.projects}
        </a>
      </nav>
      <div class="preferences">
        <nav class="languages" aria-label={t.language}>
          {(['es', 'en'] as const).map((language) => (
            <a
              href={localizedPath(language, route)}
              lang={language}
              hreflang={language}
              data-language={language}
              aria-current={language === lang ? 'true' : undefined}
              aria-label={language === 'es' ? 'Español' : 'English'}
            >
              {language.toUpperCase()}
            </a>
          ))}
        </nav>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          disabled
          aria-label={t.switchDark}
        >
          <svg
            class="theme-icon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor" stroke="none" />
          </svg>
          <span data-theme-label>{t.dark}</span>
        </button>
      </div>
    </header>
    <main id="main" class="wrap" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap">
      <div>
        <p>{t.footer}</p>
        <p class="palette-note">
          <strong>{t.palette}</strong>
          <span> · {t.paletteNote}</span>
        </p>
      </div>
      <label class="motion-control">
        <input type="checkbox" data-motion-toggle checked disabled />
        {t.motion}
      </label>
      <noscript>
        <p>{t.noJS}</p>
      </noscript>
    </footer>
    <div
      class="command-bar"
      aria-hidden="true"
      data-command-bar
      data-state="idle"
    >
      <div class="wrap command-inner">
        <span class="command-prompt">
          <span>camilo@portfolio:~</span>$
        </span>
        <span class="command-text" data-command>
          {commands[route]}
        </span>
        <span class="command-state" data-command-label>
          {t.route}
        </span>
      </div>
    </div>
    <script>
      import { initializePreferences } from '../scripts/preferences';
      import { initializeCommands } from '../scripts/commands';
      import { initializeProjects } from '../scripts/projects';
      initializePreferences();
      initializeProjects();
      initializeCommands();
    </script>
  </body>
</html>
