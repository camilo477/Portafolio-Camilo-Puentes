{
  "name": "portfolio-camilo-puentes",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "npm run dev --workspace web --",
    "build": "npm run build --workspace web",
    "check": "npm run check --workspace web",
    "lint": "prettier --check web .github package.json .prettierrc.json",
    "format": "prettier --write web .github package.json .prettierrc.json",
    "preview": "npm run preview --workspace web --",
    "test": "npm run test --workspace web",
    "screenshots": "npm run screenshots --workspace web"
  },
  "devDependencies": {
    "prettier": "3.10.0",
    "prettier-plugin-astro": "1.1.2"
  }
}
